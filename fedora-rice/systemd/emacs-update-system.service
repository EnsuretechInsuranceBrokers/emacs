# Upgrades Fedora's Emacs packages.  Installed to /etc/systemd/system by
# fedora-rice/rice.sh.  Run by hand: sudo systemctl start emacs-update-system
[Unit]
Description=Upgrade Emacs from the Fedora repos (fourth Sunday of the month)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# 'emacs*' is a dnf glob: only installed Emacs packages are upgraded.
ExecStart=/usr/bin/dnf -y -q upgrade --refresh emacs*
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
